{
  "name": "dsh-kanye-pet-settings",
  "description": "桌面宠物设置面板：在插件设置中提供桌宠开关、角色、大小透明度与互动行为配置卡片。",
  "version": "0.2.0",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-kanye-pet"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.3.0",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  }
}
