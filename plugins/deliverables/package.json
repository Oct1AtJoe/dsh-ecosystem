{
  "name": "dsh-deliverables",
  "description": "交付物展示定制：在对话流尾部清晰呈现生成的文件、多行折叠展示、历史差异对比与快速打开。",
  "version": "0.2.0",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oct1AtJoe/deepseek-harness-enhanced.git",
    "directory": "packages/client/ui-deliverables-custom"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-test-runtime": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1 <0.3.0",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  }
}
