{
  "name": "dsh-session-folders",
  "version": "0.4.0",
  "description": "会话管理：文件夹组织（多级文件夹、拖拽归档、置顶、右键自动命名）与智能标题生成（MMDD｜类型｜主题、多模型托底链、思考预算保护）。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-title": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "folders",
    "sessions",
    "sidebar",
    "session-title",
    "title-generation"
  ],
  "license": "MIT"
}
