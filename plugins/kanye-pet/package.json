{
  "name": "@deepseek-ai/dsh-kanye-pet",
  "version": "0.1.1-rc.3",
  "type": "module",
  "description": "DSH 桌面互动宠物核心：支持状态感知、气泡对话、动作表情与桌面窗口悬浮互动。",
  "icon": "./icon.svg",
  "main": "lib/index.mjs",
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "lib/client",
    "lib/src",
    "lib/assets/characters",
    "lib/assets/manifest.json",
    "lib/assets/pet",
    "lib/assets/sounds",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "scripts": {
    "gates": "node scripts/gates/run.mjs",
    "gates:ci": "node scripts/gates/run.mjs --group ci",
    "test": "node --test 'tests/*.test.mjs'",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/whale-girl.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
