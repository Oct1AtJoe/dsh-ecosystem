{
  "name": "dsh-kanye-pet",
  "version": "0.3.1",
  "type": "module",
  "description": "DSH 桌面互动宠物核心：支持状态感知、气泡对话、动作表情与桌面窗口悬浮互动。",
  "icon": "./icon.svg",
  "main": "lib/index.mjs",
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "lib/src",
    "lib/assets/characters",
    "lib/assets/manifest.json",
    "lib/assets/pet",
    "lib/assets/sounds",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test \"tests/*.test.mjs\"",
    "gates": "node --test \"tests/*.test.mjs\" && node tests/jump-check.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.3.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/whale-girl.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.3.0",
    "react": "^18.2.0"
  }
}
