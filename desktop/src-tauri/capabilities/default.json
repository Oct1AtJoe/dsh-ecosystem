{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and pet window",
  "windows": ["main", "pet", "content"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1*",
      "http://127.0.0.1:3080",
      "http://localhost:*",
      "http://localhost*",
      "http://localhost:3080"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position"
  ]
}
