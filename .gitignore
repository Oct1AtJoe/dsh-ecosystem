# ==========================================
# 独立外部仓库（自带独立 .git，严防嵌套冲突）
# ==========================================
/external-repos/

# ==========================================
# 依赖包与编译缓存（排除 7GB+ Rust target 与 node_modules）
# ==========================================
node_modules/
**/node_modules/
**/target/
**/dist/
*.tsbuildinfo

# ==========================================
# 本地动态数据与历史归档
# ==========================================
/data/
/archive/
/.workbuddy/
/.dsh/
/.agent-teams/

# ==========================================
# 临时日志与系统文件
# ==========================================
*.bak
*.log
*.tmp
.tmp-*
.DS_Store
Thumbs.db

# ==========================================
# 一次性调试脚本与反编译残留（临时产物，勿提交）
# *.asardump.js = 从 app.asar 反编译出来对拍用的文件，用完即弃
# ==========================================
/scratch/
/.tmp/
*.asardump.js

# ==========================================
# asar 补丁的 apply 前快照（529KB 的 main.js，逐节点重建，不入库）
#   dsh-desktop-window-state 的 --revert 走纯文本逆操作，不读该快照
# ==========================================
main.js.pre-window-state

# ==========================================
# 凭据与密钥（明文 token，严禁提交）
# ==========================================
*git-credentials*

# ==========================================
# 发布产物：tarball 上传到 GitHub Release，不进 git
# 重新生成：node scripts/pack-plugins.mjs
# ==========================================
/dist-tarballs/

# ==========================================
# 本地构建物化产物与数据抢救备份
# ==========================================
/desktop/bundle-resources/
/recovery/

# ==========================================
# 第三方包离线备份（降级回滚用，不进 git）
#   vendor/ra-0.4.4/ = dsh-reference-anything 0.4.4 原始包
#   用途：0.5.x 的 $mount 卡启动 bug 修复后，从这里重装或对比
# ==========================================
/vendor/

# ==========================================
# 工作区临时目录（fork 源码、构建中间产物、一次性验证脚本）
#   .work/wb-fork-src/ = dsh-connect-workbuddy 5.12.4 fork
#   用途：重新构建 workbuddy-proxy.mjs 时对照上游改动的底稿
#   产物已独立部署在 Desktop\CLIProxyAPI_*\，本目录删掉不影响运行
# ==========================================
/.work/


